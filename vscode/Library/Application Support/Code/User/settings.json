{
  // ── Editor ────────────────────────────────────────────────────────────
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.fontSize": 14,
  "editor.fontFamily": "JetBrains Mono, Menlo, monospace",
  "editor.fontLigatures": true,
  "editor.formatOnSave": true,
  "editor.minimap.enabled": false,
  "editor.tabCompletion": "on",
  "editor.suggestSelection": "first",
  "editor.wordWrap": "wordWrapColumn",
  "editor.wordWrapColumn": 100,
  "editor.rulers": [80, 100],
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": "active",
  "editor.stickyScroll.enabled": true,
  "editor.linkedEditing": true,
  "editor.inlayHints.enabled": "onUnlessPressed",
  "editor.detectIndentation": false,
  "diffEditor.ignoreTrimWhitespace": false,

  // ── Positron-style chrome (mirrors ~/Library/.../Positron/User/settings.json)
  // Scrollbars, breadcrumbs, line highlight, indent guides, gutter git
  // decorations and the layout control stay at their VS Code defaults.
  "editor.renderWhitespace": "trailing",
  "editor.renderFinalNewline": "dimmed",
  "editor.showFoldingControls": "always",
  "editor.snippetSuggestions": "top",
  "workbench.editor.highlightModifiedTabs": true,
  "workbench.startupEditor": "none",
  "workbench.tips.enabled": false,
  "explorer.compactFolders": false,

  // ── Files ─────────────────────────────────────────────────────────────
  // autoSave off: same as Positron. If Claude Code edits a file on disk,
  // VS Code offers compare/revert instead of a silent overwrite.
  "files.autoSave": "off",
  "files.hotExit": "onExit",
  "workbench.editor.closeOnFileDelete": false,
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "files.exclude": {
    "**/node_modules": true,
    "**/.classpath": true,
    "**/.project": true,
    "**/.settings": true,
    "**/.factorypath": true,
    "**/Pods": true,
    "**/.Rproj.user": true,
    "**/__pycache__": true,
    "**/.ruff_cache": true,
    "**/.pytest_cache": true,
    "**/.venv": true,
  },
  "search.exclude": {
    "**/renv/library": true,
    "**/.venv": true,
    "**/build": true,
    "**/*.rds": true,
    "**/node_modules": true,
  },
  "files.watcherExclude": {
    "**/renv/library/**": true,
    "**/.venv/**": true,
    "**/build/**": true,
  },
  "files.associations": {
    "*.qmd": "quarto",
    "*.Rmd": "rmd",
    "Brewfile": "ruby",
  },
  // ── Workbench / window ────────────────────────────────────────────────
  // Same theme as Positron. Keep this key: without it, VS Code falls back
  // to its default dark theme.
  "workbench.colorTheme": "Cobalt2",
  "workbench.productIconTheme": "fluent-icons",
  "workbench.iconTheme": "material-icon-theme",
  "workbench.colorCustomizations": {
    "[Cobalt2]": {
      "tab.activeBackground": "#193549",
      "tab.inactiveBackground": "#122738",
      "tab.activeBorder": "#ffc600",
      "tab.border": "#15232D",
      "editorGroupHeader.tabsBackground": "#122738",
      "editorGroupHeader.noTabsBackground": "#193549",
      "editor.background": "#193549",
      "sideBar.background": "#15232D",
      "activityBar.background": "#122738",
      "titleBar.activeBackground": "#15232D",
      "statusBar.background": "#15232D",
      "panel.background": "#122738",
    },
  },
  "workbench.statusBar.visible": true,
  "workbench.activityBar.location": "default",
  // Positron layout: secondary side bar open on the right for the session
  // views (R Workspace, R Help, Jupyter Variables). VS Code stores view
  // placement in its state database, so move those views there once by hand.
  "workbench.secondarySideBar.defaultVisibility": "visibleInWorkspace",
  "workbench.editor.limit.enabled": true,
  "workbench.editor.limit.value": 12,
  "workbench.editor.limit.perEditorGroup": true,
  "window.title": "${activeEditorFull}${separator}${rootName}",
  "window.restoreWindows": "all",
  "zenMode.centerLayout": false,
  "zenMode.fullScreen": false,
  "zenMode.restore": true,

  // ── Terminal ──────────────────────────────────────────────────────────
  "terminal.external.osxExec": "Ghostty.app",
  // Nerd Font variant: the Starship prompt needs its glyphs.
  "terminal.integrated.fontFamily": "JetBrainsMono Nerd Font Mono",
  "terminal.integrated.fontSize": 14,
  "terminal.integrated.scrollback": 20000,
  "terminal.integrated.defaultProfile.osx": "zsh",

  // ── Git ───────────────────────────────────────────────────────────────
  "git.autofetch": true,
  "git.confirmSync": false,
  "git.enableSmartCommit": true,
  "git.untrackedChanges": "separate",
  "gitlens.currentLine.enabled": false,
  "gitlens.codeLens.enabled": false,
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,

  // ── Python (UV + ruff, per global conventions) ─────────────────────────
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports.ruff": "explicit",
      "source.fixAll.ruff": "explicit",
    },
  },
  "python.languageServer": "Pylance",
  "python.analysis.typeCheckingMode": "basic",
  "python.terminal.activateEnvironment": true,
  "python.testing.pytestEnabled": true,
  // Native REPL: a console with history and a Variables view, the closest
  // VS Code match to the Positron Python console.
  "python.REPL.sendToNativeREPL": true,
  "python.REPL.provideVariables": true,
  "ruff.nativeServer": "on",
  "notebook.formatOnSave.enabled": true,
  "notebook.codeActionsOnSave": {
    "notebook.source.organizeImports.ruff": "explicit",
  },
  "jupyter.askForKernelRestart": false,

  // ── R (Air formatter) ─────────────────────────────────────────────────
  "r.lsp.enabled": true,
  "r.rterm.mac": "/usr/local/bin/R",
  "r.rpath.mac": "/usr/local/bin/R",
  "r.bracketedPaste": true,
  // auto: jgd, then httpgd, then the static viewer. Plots open in column Two,
  // to the right of the editor, like the Positron Plots pane.
  "r.plot.backend": "auto",
  // false: Cmd+Enter goes to a dedicated R console (created on first use),
  // not to whatever zsh terminal has focus. This is the Positron console.
  "r.alwaysUseActiveTerminal": false,
  "r.rterm.option": ["--no-save", "--no-restore", "--quiet"],
  "r.sessionWatcher": true,
  "r.session.viewers.viewColumn": {
    "plot": "Two",
    "browser": "Active",
    "viewer": "Two",
    "pageViewer": "Active",
    "help": "Two",
  },
  "[r]": {
    "editor.defaultFormatter": "Posit.air-vscode",
    "editor.formatOnSave": true,
    "editor.tabSize": 2,
  },
  "[rmd]": {
    "editor.defaultFormatter": "REditorSupport.r",
    "editor.formatOnSave": false,
    "editor.tabSize": 2,
  },

  // ── Quarto ────────────────────────────────────────────────────────────
  "quarto.render.previewType": "internal",
  "[quarto]": {
    "editor.wordWrap": "on",
    "editor.formatOnSave": false,
  },

  // ── LaTeX (mirrors the nvim/VimTeX setup: latexmk + lualatex + build/) ─
  "latex-workshop.latex.outDir": "%DIR%/build",
  "latex-workshop.latex.autoBuild.run": "onSave",
  "latex-workshop.latex.recipe.default": "first",
  "latex-workshop.latex.tools": [
    {
      "name": "latexmk-lualatex",
      "command": "latexmk",
      "args": [
        "-lualatex",
        "-shell-escape",
        "-file-line-error",
        "-synctex=1",
        "-interaction=nonstopmode",
        "-outdir=%OUTDIR%",
        "%DOC%",
      ],
    },
  ],
  "latex-workshop.latex.recipes": [
    {
      "name": "latexmk (lualatex)",
      "tools": ["latexmk-lualatex"],
    },
  ],
  "latex-workshop.latex.clean.subfolder.enabled": true,
  // never: cleaning after each build destroys .bcf/.bbl and breaks biber
  // citation resolution. Clean manually (⇧⌘P → "LaTeX Workshop: Clean").
  "latex-workshop.latex.autoClean.run": "never",
  // Root-file resolution for the paper/ + presentation/ + bib/ project layout
  "latex-workshop.latex.rootFile.doNotPrompt": true,
  "latex-workshop.latex.search.rootFiles.include": ["**/*.tex"],
  "latex-workshop.latex.bibDirs": ["${workspaceFolder}/bib"],
  // Completion — the VimTeX/cmp-vimtex equivalent
  "latex-workshop.intellisense.citation.label": "authorYearTitle",
  "latex-workshop.intellisense.package.enabled": true,
  "latex-workshop.intellisense.unimathsymbols.enabled": true,
  // Quickfix noise: mirrors vimtex_quickfix_ignore_filters in vimtex.lua
  "latex-workshop.message.badbox.show": false,
  "latex-workshop.message.error.show": true,
  "latex-workshop.bibtex-format.tab": "  ",
  "latex-workshop.bibtex-format.sort.enabled": true,
  "latex-workshop.view.pdf.viewer": "external",
  "latex-workshop.view.pdf.external.viewer.command": "/Applications/Skim.app/Contents/SharedSupport/displayline",
  "latex-workshop.view.pdf.external.viewer.args": [
    "-r",
    "%LINE%",
    "%PDF%",
    "%TEX%",
  ],
  "latex-workshop.view.pdf.external.synctex.command": "/Applications/Skim.app/Contents/SharedSupport/displayline",
  "latex-workshop.view.pdf.external.synctex.args": [
    "-r",
    "-g",
    "%LINE%",
    "%PDF%",
    "%TEX%",
  ],
  "[latex]": {
    "editor.wordWrap": "on",
    "editor.formatOnSave": false,
  },
  "[bibtex]": {
    "editor.formatOnSave": false,
  },

  // ── Julia ─────────────────────────────────────────────────────────────
  "julia.enableTelemetry": false,
  "julia.symbolCacheDownload": true,
  "[julia]": {
    "editor.tabSize": 4,
    "editor.formatOnSave": true,
  },
  "MATLAB.installPath": "/Applications/MATLAB_R2024b.app",
  "MATLAB.indexWorkspace": true,
  "MATLAB.telemetry": false,
  "[matlab]": {
    "files.encoding": "utf8",
    "editor.tabSize": 4,
    "editor.defaultFormatter": "MathWorks.language-matlab",
    "editor.formatOnSave": true,
  },

  // ── Web / JS (prettier) ───────────────────────────────────────────────
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[yaml]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "javascript.updateImportsOnFileMove.enabled": "always",
  "typescript.updateImportsOnFileMove.enabled": "always",

  // ── Markdown ──────────────────────────────────────────────────────────
  "[markdown]": {
    "editor.wordWrap": "on",
    "editor.quickSuggestions": {
      "other": true,
    },
    "editor.formatOnSave": false,
  },

  // ── Neovim (LazyVim config drives VS Code via vscode-neovim) ──────────
  "vscode-neovim.neovimExecutablePaths.darwin": "/opt/homebrew/bin/nvim",
  // Required: without a dedicated extension host process, typing lags badly.
  "extensions.experimental.affinity": {
    "asvetliakov.vscode-neovim": 1,
  },
  "editor.lineNumbers": "relative",
  "editor.scrollBeyondLastLine": false,
  "workbench.list.automaticKeyboardNavigation": false,

  // ── Misc ──────────────────────────────────────────────────────────────
  // todo-tree relies on VS Code's bundled @vscode/ripgrep, which is not
  // present in 1.129's app bundle — point it at the Homebrew rg instead.
  "todo-tree.ripgrep.ripgrep": "/opt/homebrew/bin/rg",
  "todo-tree.general.tags": ["TODO", "FIXME", "HACK", "NOTE", "XXX"],
  "telemetry.telemetryLevel": "off",
  "redhat.telemetry.enabled": false,
  "update.showReleaseNotes": false,
  "extensions.ignoreRecommendations": true,
  "claudeCode.preferredLocation": "panel",
  "terminal.integrated.commandsToSkipShell": [
    "language-julia.interrupt",
    "matlab.interrupt",
  ],
  "julia.enableCrashReporter": true,
  "gitlens.views.scm.grouped.views": {
    "commits": true,
    "branches": true,
    "remotes": true,
    "stashes": true,
    "tags": true,
    "worktrees": true,
    "contributors": true,
    "fileHistory": false,
    "repositories": true,
    "searchAndCompare": false,
    "launchpad": true,
  },
}
