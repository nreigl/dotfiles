# NOTE:
# Lives at the XDG path (~/.config/ghostty/config), NOT the macOS bundle path
# (~/Library/Application Support/com.mitchellh.ghostty/config). Ghostty.app reads
# both, but embedded/libghostty hosts (cmux) read ONLY the XDG path — keeping the
# config here means Option handling (macos-option-as-alt) applies in cmux too.
#
# docs:
# ghostty +show-config --default --docs | nvim
# examples:
# https://github.com/search?q=path%3Aghostty%2Fconfig&type=code

# ghostty +list-fonts

font-size = 14

# monospace
# https://usgraphics.com/products/berkeley-mono
font-family = "Berkeley Mono Variable"
font-variation = wght=300
font-variation = wdth=100
font-family-bold = "Berkeley Mono Variable"
font-variation-bold = wght=800

# italics
# https://github.com/subframe7536/maple-font
font-family-italic = "Maple Mono"
font-variation-italic = wght=200
font-family-bold-italic = "Maple Mono"
font-variation-bold-italic = wght=800

window-title-font-family = "Berkeley Mono Variable"

alpha-blending = linear-corrected

macos-titlebar-style = tabs
macos-titlebar-proxy-icon = hidden
# Left Option composes special chars (@, \, €, ...). Right Option is a real
# Alt, which herdr needs for [keys.indexed] tabs = "alt" (Alt+1..9 tab
# switching), focus_agent = "prefix+alt+1..9", and the prefix+alt+g lazygit
# popup. With "false" on both keys, herdr never saw an Alt key at all.
macos-option-as-alt = right

# cmd+shift+o toggles between this value and fully opaque.
# Lower is more transparent. 0.65 was the old WezTerm-parity value.
background-opacity = 0.5
background-blur-radius = 40

# Ghostty updates itself by default. Homebrew is authoritative here, so two
# updaters would fight. Update with: brew upgrade --cask ghostty
auto-update = off

# Background image mode (Ghostty 1.2+).
# Uncomment and point at a real image; tune opacity to taste.
# background-image = ~/Pictures/wallpaper.jpg
# background-image-fit = cover
# background-image-opacity = 0.25

# Desktop notification when a command running >5s finishes in an
# unfocused window — handy for long pipeline runs and agents (1.3+)
notify-on-command-finish = unfocused
notify-on-command-finish-action = bell,notify

# ghostty +list-themes
# Follows macOS appearance automatically (no script/plugin needed)
theme = dark:Ayu Mirage,light:Ayu Light

mouse-hide-while-typing = true

window-inherit-working-directory = false
working-directory = home

# keymaps
# Was global:cmd+` — that is the macOS "Move focus to next window" shortcut
# (symbolic hotkey 27), and a global: binding steals it from every application.
keybind = global:ctrl+cmd+`=toggle_quick_terminal
keybind = shift+ctrl+left_bracket=previous_tab
keybind = shift+ctrl+right_bracket=next_tab
keybind = shift+ctrl+,=move_tab:-1
keybind = shift+ctrl+.=move_tab:+1
# Flip between configured transparency and fully opaque
keybind = cmd+shift+o=toggle_background_opacity
# WezTerm parity (was CTRL|CMD+f there). Matches the macOS system shortcut.
keybind = ctrl+cmd+f=toggle_fullscreen

# shader
# vendored from https://github.com/hackr-sh/ghostty-shaders (see shaders/)
# options: shaders/cursor_blaze.glsl, shaders/cursor_lightning.glsl
# custom-shader = ~/.config/ghostty/shaders/cursor_blaze.glsl

