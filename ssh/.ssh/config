# SSH Client Configuration
# Security-focused defaults. Key exchange and host key algorithms use the OpenSSH defaults.

# Global defaults
Host *
    # Security
    PasswordAuthentication no
    # Replaces ChallengeResponseAuthentication, deprecated in OpenSSH 8.7
    KbdInteractiveAuthentication no
    PubkeyAuthentication yes
    # No KexAlgorithms or HostKeyAlgorithms pin. The OpenSSH defaults put the
    # post-quantum mlkem768x25519 and sntrup761x25519 key exchanges first and
    # accept ECDSA host keys. A pin drops the first and blocks ECDSA-only hosts.
    # Ciphers and MACs stay pinned: they only remove CTR modes, SHA-1, and
    # MAC-then-encrypt from the defaults.
    Ciphers chacha20-poly1305@openssh.com,aes256-gcm@openssh.com,aes128-gcm@openssh.com
    MACs hmac-sha2-512-etm@openssh.com,hmac-sha2-256-etm@openssh.com
    
    # Connection
    ServerAliveInterval 60
    ServerAliveCountMax 3
    TCPKeepAlive yes
    Compression yes
    
    # Multiplexing for performance
    ControlMaster auto
    ControlPath ~/.ssh/sockets/%r@%h:%p
    ControlPersist 10m
    
    # Security hardening
    StrictHostKeyChecking ask
    VerifyHostKeyDNS yes
    ForwardAgent no
    ForwardX11 no
    HashKnownHosts yes
    
    # Use 1Password SSH agent if available
    # IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"

# GitHub
Host github.com
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_ed25519
    AddKeysToAgent yes
    UseKeychain yes

# GitLab
Host gitlab.com
    HostName gitlab.com
    User git
    IdentityFile ~/.ssh/id_ed25519
    AddKeysToAgent yes
    UseKeychain yes

# Example: Personal Server
# Host myserver
#     HostName server.example.com
#     User myusername
#     Port 22
#     IdentityFile ~/.ssh/id_ed25519
#     ForwardAgent yes  # Only if needed

