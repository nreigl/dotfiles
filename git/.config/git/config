# Machine-local settings and the identity (user.name, user.email) live in
# ~/.gitconfig. That file is an untracked real file, not a symlink. Git reads
# it after this file, so its keys win, and `git config --global` writes there.
[core]
  editor = nvim
  excludesfile = ~/.config/git/ignore
  ignorecase = false
  abbrev = 12
  # Enable git-delta for better diffs
  pager = delta
[alias]
  # Logging
  l  = log --graph --oneline --decorate
  ld = log --graph --pretty=format:'%C(yellow)%h%C(bold white red)%d%Creset %s %C(bold green)%cr %Creset%C(white)%an' --abbrev-commit --date=relative
  ll = log --stat --decorate --source -p
  branches = for-each-ref --sort=-committerdate --format=\"%(color:blue)%(authordate:relative)\t%(color:red)%(authorname)\t%(color:white)%(color:bold)%(refname:short)\" refs/remotes
  
  # Common operations
  s = status -sb
  a = add
  aa = add --all
  ap = add --patch
  c = commit
  cm = commit -m
  ca = commit --amend
  cam = commit --amend --no-edit
  
  # Branching
  co = checkout
  cob = checkout -b
  br = branch
  brd = branch -d
  
  # Stashing
  st = stash
  stp = stash pop
  stl = stash list
  
  # Reset & Clean
  undo = reset HEAD~1 --mixed
  unstage = reset HEAD --
  clean-branches = !git branch --merged | grep -v '\\*\\|main\\|master' | xargs -n 1 git branch -d
  
  # Info
  last = log -1 HEAD
  contributors = shortlog --summary --numbered
  today = log --since=midnight --author='Nicolas Reigl' --oneline

  # Review in hunk (opt-in). core.pager stays delta on purpose: delta is what
  # scripts and pipes get, and routing every `git diff` through an interactive
  # TUI would break them. These aliases override the pager for one command.
  # NOTE: `git hdiff` shows only what git puts in the patch, so untracked files
  # are absent. Use the `hd` shell alias (`hunk diff`) to see those.
  # The quotes must be escaped. Git strips an unescaped pair while it reads the
  # value, and `git` then splits `hunk pager` into two argv words and looks for
  # a `pager` subcommand.
  hdiff = -c core.pager=\"hunk pager\" diff
  hshow = -c core.pager=\"hunk pager\" show
[difftool "hunk"]
  # Same escaping rule as the aliases above: git strips unescaped quotes, and
  # the unquoted value breaks on a path that contains a space.
  cmd = hunk difftool \"$LOCAL\" \"$REMOTE\" \"$MERGED\"
[difftool]
  # `prompt` has no per-tool form, so this applies to whichever tool
  # `diff.tool` selects. That is hunk, set in the [diff] section below.
  prompt = false
[color]
  ui = auto
[diff]
  algorithm = patience
  colorMoved = zebra
  # Makes the [difftool "hunk"] block above reachable. Without it `git difftool`
  # never selects hunk and the block is dead config.
  tool = hunk
[push]
  default = current
[commit]
  verbose = true
  # template = ~/.gitmessage
[fetch]
  prune = true
[rebase]
  autosquash = true
  autostash = true
[pager]
  branch = false
# The identity is in ~/.gitconfig (untracked). See the note at the top.
[pull]
	rebase = true
[init]
	defaultBranch = main
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

[delta]
  navigate = true
  light = false
  side-by-side = false
  line-numbers = true
  features = decorations

[delta "decorations"]
  commit-decoration-style = bold yellow box ul
  file-style = bold yellow ul
  file-decoration-style = none
  hunk-header-decoration-style = cyan box ul

[interactive]
  diffFilter = delta --color-only
[merge]
  conflictStyle = zdiff3
[tag]
  sort = version:refname
